# Wzór zmiennych dla testów z katalogu tests/ (np. `set -a; source .env; set +a` przed `npm run test:api`).
# Plik .env NIGDY nie trafia do repozytorium.

# Adres aplikacji (frontend; API pod /api). Lokalnie Vite z prawdziwym backendem (bez VITE_FAKE_API).
LIVE_APP_URL=http://localhost:5173
# Konto testowe – TECHNICIAN, żeby test mógł usunąć zgłoszenie, które utworzył (logowanie: #94).
TEST_USER_EMAIL=tech.jan@clouddesk.example
# Lokalnie: DEMO_PASSWORD z backend/.env; w CI: sekret środowiska azure.
TEST_USER_PASSWORD=
# Nagłówki bezpieczeństwa dodaje Nginx: auto = sprawdzaj, gdy LIVE_APP_URL nie wskazuje na localhost; true/false wymusza.
CHECK_SECURITY_HEADERS=auto
