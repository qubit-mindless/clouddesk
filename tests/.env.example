# Zmienne dla testów na żywym środowisku. Ustaw w powłoce przed `npm run test:api`
# (testy nie czytają pliku .env – to tylko lista zmiennych).

# Adres działającej aplikacji, bez końcowego "/". Domyślnie lokalny backend.
# Przez Nginx (np. adres z README) sprawdzane są też nagłówki bezpieczeństwa.
LIVE_APP_URL=http://localhost:8000

# Konto testowe (po wdrożeniu logowania, #14). Puste = testy bez tokenu.
# Konto musi móc tworzyć i usuwać zgłoszenia (np. admin@clouddesk.example z hasłem DEMO_PASSWORD).
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Nagłówki bezpieczeństwa dodaje Nginx. auto = sprawdzaj, gdy LIVE_APP_URL nie wskazuje na localhost; true/false wymusza.
CHECK_SECURITY_HEADERS=auto
