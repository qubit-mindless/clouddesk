# Skopiuj do .env.local. Adres API nigdy nie jest wpisany na sztywno w kodzie.
# Domyślnie /api: lokalnie przekazuje je proxy Vite (localhost:8000), w Azure Nginx na VM.
VITE_API_BASE_URL=/api

# true = `npm run dev` odpowiada na /api udawanym API z dev/fakeApi.ts (dane z src/mocks, bez backendu).
VITE_FAKE_API=false
