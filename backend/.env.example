# Skopiuj do .env i uzupełnij. Plik .env NIGDY nie trafia do repozytorium.
APP_ENV=local
APP_VERSION=0.1.0
# Format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DB_NAME
DATABASE_URL=postgresql+psycopg://clouddesk:clouddesk@localhost:5432/clouddesk
# Adresy frontendu dopuszczone przez CORS (lista po przecinku)
CORS_ORIGINS=http://localhost:5173
# Tylko dla pytest (opcjonalne): OSOBNA, pusta baza do testu migracji – test kasuje w niej tabele.
# Ustaw w powłoce przed `pytest`, np.: docker exec config-db-1 createdb -U clouddesk clouddesk_test
# TEST_DATABASE_URL=postgresql+psycopg://clouddesk:clouddesk@localhost:5432/clouddesk_test
