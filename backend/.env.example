# Skopiuj do .env i uzupełnij. Plik .env NIGDY nie trafia do repozytorium.
APP_ENV=local
APP_VERSION=0.1.0
# SHA commita pokazywany w /api/health. W obrazie ustawia go build-arg GIT_SHA (pipeline CD); lokalnie zostaw "local".
GIT_SHA=local
# Format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DB_NAME
DATABASE_URL=postgresql+psycopg://clouddesk:clouddesk@localhost:5432/clouddesk
# Adresy frontendu dopuszczone przez CORS (lista po przecinku)
CORS_ORIGINS=http://localhost:5173
# Tylko dla pytest (opcjonalne): OSOBNA, pusta baza do testu migracji – test kasuje w niej tabele.
# Ustaw w powłoce przed `pytest`, np.: docker exec config-db-1 createdb -U clouddesk clouddesk_test
# TEST_DATABASE_URL=postgresql+psycopg://clouddesk:clouddesk@localhost:5432/clouddesk_test
# Klucz do podpisywania tokenów JWT (min. 32 znaki), np. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Lokalnie można zostawić puste – klucz losuje się przy starcie (po restarcie trzeba zalogować się ponownie).
# W Azure: sekret jwt-secret w Key Vault (Terraform); poza APP_ENV=local brak klucza zatrzymuje start.
JWT_SECRET=
# Czas życia tokenu w minutach
JWT_TTL_MINUTES=60
# Hasło kont demo (admin@, tech.jan@, anna.k@… clouddesk.example) ustawiane przez `python -m app.db.seed`.
# Puste = konta bez możliwości logowania. W Azure: sekret demo-password w Key Vault.
DEMO_PASSWORD=
# Asystent AI (Azure OpenAI). Bez AZURE_OPENAI_ENDPOINT asystent jest wyłączony (panel pokazuje informację).
# W Azure: endpoint i nazwa wdrożenia z Terraformu, logowanie tożsamością zarządzaną backendu (AZURE_CLIENT_ID).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
# Klucz tylko do testów lokalnych – w Azure zostaw pusty (wtedy token z tożsamości zarządzanej).
AZURE_OPENAI_API_KEY=
AZURE_CLIENT_ID=
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=500
# Limit odpowiedzi asystenta na jedno zgłoszenie (kontrola kosztów)
AI_MAX_ANSWERS_PER_TICKET=10
