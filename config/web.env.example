# Wzór /etc/clouddesk/web.env na VM w snet-web. Plik tworzy config/deploy-web.sh z wartości podanych
# przy wdrożeniu (w CD: deploy.yml), więc ręcznie nie trzeba go zakładać.

# Wewnętrzny adres backendu (ingress Container Apps): tylko schemat i host, bez ścieżki i końcowego "/".
BACKEND_INTERNAL_URL=https://<nazwa-aplikacji>.internal.<środowisko>.<region>.azurecontainerapps.io
# Publiczna nazwa DNS VM – certyfikat TLS i cel przekierowania z portu 80. Bez https://.
WEB_DOMAIN=<etykieta>.<region>.cloudapp.azure.com
